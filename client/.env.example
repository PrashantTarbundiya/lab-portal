# ==============================================================================
# Client / Frontend Environment Configuration (Vercel / Vite)
# ==============================================================================

# Backend API URL (e.g. Render backend URL: https://lab-portal-backend.onrender.com/api)
# Leave empty for local development to use local Vite reverse proxy (/api)
VITE_API_BASE_URL=

# Supabase Client Authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Demo Mode & Payment Integration
VITE_OTP_DEMO_MODE=true
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
