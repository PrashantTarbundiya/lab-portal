# ==============================================================================
# Backend Docker Container Environment Configuration
# ==============================================================================

# Server Network & Runtime
PORT=3000
NODE_ENV=production
APP_BASE_URL=http://localhost:5173

# Database Connection (Prisma)
# - Local Docker Compose: postgresql://postgres:postgres@postgres:5432/lab_portal?schema=public
# - Remote Managed Postgres (Supabase/Neon/RDS):
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/lab_portal?schema=public"
DIRECT_URL="postgresql://postgres:postgres@postgres:5432/lab_portal?schema=public"

# Database Auto-Seed on Startup (true for demo/staging, false for live production)
AUTO_SEED=true

# Security & Data Protection (DPDP Act 2023)
APP_HASH_SECRET=super-secret-dev-hash-key-12345
LAB_NAME="Company A Diagnostics"
OTP_DEMO_MODE=true
DEMO_PASSWORD=Demo@12345
LINK_TTL_HOURS=72

# AI Interpretation Engine (Google Gemini / OpenRouter / Anthropic)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

